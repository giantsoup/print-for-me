# Placeholder reference only. setup-production.ps1 generates the real file privately.
APP_NAME="Print for Me"
APP_ENV=production
APP_KEY=REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
APP_URL=https://print-for-me.chimp-hamal.ts.net
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null
DB_CONNECTION=sqlite
DB_DATABASE=C:/Users/REPLACE_USER/AppData/Local/PrintForMe/production/data/database.sqlite
ADMIN_EMAIL=REPLACE_WITH_OWNER_EMAIL
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_COOKIE=print_for_me_local_production_session
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=print_for_me_local_production_
MAIL_MAILER=log
MAIL_FROM_ADDRESS="print-for-me@localhost.invalid"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LOGO_PATH="apple-touch-icon.png"
MAIL_LOGO_ALT="${APP_NAME} logo"
TRUSTED_PROXIES=127.0.0.1
VITE_APP_NAME="${APP_NAME}"
